def node : String → IExpr → IExpr
  | "exp", a => .exp a | "log", a => .log a | "sin", a => .sin a | "cos", a => .cos a
  | "sinh", a => .sinh a | "cosh", a => .cosh a | "tanh", a => .tanh a
  | "log2", a => .log2 a | _, a => .log10 a

def encl (F : DI) (r : Rat) : Bool :=
  let tol := (if r < 0 then -r else r) / 10 ^ 49 + 1 / 10 ^ 60
  match F.lo, F.hi with
  | some a, some b => toRat a ≤ r + tol && r - tol ≤ toRat b
  | _, _ => false

def relW (F : DI) (r : Rat) : Float :=
  match F.lo, F.hi with
  | some a, some b =>
    let w := (toRat b - toRat a) * 2 ^ 128 / (if r < 0 then -r else r)
    Float.ofScientific w.num.natAbs true 0 / w.den.toFloat * (if w.num < 0 then -1 else 1)
  | _, _ => 1e300

def run : IO Nat := do
  let mut bad := 0
  let mut worst : List (String × Float) := []
  for (f, x, r) in refs do
    let F := evalQ [] (node f (.rat x))
    let w := relW F r
    if !encl F r then
      bad := bad + 1
      IO.println s!"  FAIL {f} {x}: {F.toString} vs {r}"
    worst := match worst.find? (·.1 == f) with
      | some (_, w0) => if w > w0 then (f, w) :: worst.filter (·.1 != f) else worst
      | none => (f, w) :: worst
  -- intervals
  let mut nI := 0
  for f in ["exp", "log", "sin", "cos", "sinh", "cosh", "tanh", "log2", "log10"] do
    let rs := refs.filter (·.1 == f)
    for (p, q) in rs.zip rs.tail do
      let (_, a, ra) := p; let (_, b, rb) := q
      let X := DI.ofRatI (min a b) (max a b)
      let F := evalQ [X] (node f (.var 0))
      nI := nI + 1
      if !(encl F ra && encl F rb) then
        bad := bad + 1
        IO.println s!"  FAIL interval {f} [{a}, {b}]: {F.toString}"
  IO.println s!"  dyadic elementary functions: {refs.length} points, {nI} intervals"
  IO.println s!"  max width/|f x| (units of 2^-128): {worst.reverse.map fun (f, w) => s!"{f} {w}"}"
  IO.println s!"Interval128 dyadic function failures: {bad}"
  return bad

end Interval128DyTests
