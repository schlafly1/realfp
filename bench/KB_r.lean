import Lean
open Lean Elab Command Meta
/-- `#kbench n "label" t₁ = v₁` : time `Kernel.isDefEq t₁ v₁` (n repetitions), print µs/rep. -/
elab "#kbench " n:num lbl:str t:term : command => liftTermElabM do
  let e ← Term.elabTerm t none
  Term.synthesizeSyntheticMVarsNoPostponing
  let e ← instantiateMVars e
  let some (_, lhs, rhs) := e.eq? | throwError "need equation"
  let env ← getEnv
  let t0 ← IO.monoNanosNow
  let mut ok := true
  for _ in [0:n.getNat] do
    match Kernel.isDefEq env {} lhs rhs with
    | .ok b => ok := ok && b
    | .error _ => ok := false
  let t1 ← IO.monoNanosNow
  logInfo m!"{lbl.getString}: {(t1 - t0) / 1000 / n.getNat} µs  ok={ok}"
def r1 (n : Nat) : Nat := cond (Nat.ble (nat_lit 2) n) (nat_lit 1) (nat_lit 0)
def r2 (n : Nat) : Nat := cond (Nat.ble (nat_lit 4) n) (Nat.add (nat_lit 2) (r1 (Nat.shiftRight n (nat_lit 2)))) (r1 n)
def r4 (n : Nat) : Nat := cond (Nat.ble (nat_lit 16) n) (Nat.add (nat_lit 4) (r2 (Nat.shiftRight n (nat_lit 4)))) (r2 n)
def r8 (n : Nat) : Nat := cond (Nat.ble (nat_lit 256) n) (Nat.add (nat_lit 8) (r4 (Nat.shiftRight n (nat_lit 8)))) (r4 n)
def r16 (n : Nat) : Nat := cond (Nat.ble (nat_lit 65536) n) (Nat.add (nat_lit 16) (r8 (Nat.shiftRight n (nat_lit 16)))) (r8 n)
def r32 (n : Nat) : Nat := cond (Nat.ble (nat_lit 4294967296) n) (Nat.add (nat_lit 32) (r16 (Nat.shiftRight n (nat_lit 32)))) (r16 n)
def r64 (n : Nat) : Nat := cond (Nat.ble (nat_lit 18446744073709551616) n) (Nat.add (nat_lit 64) (r32 (Nat.shiftRight n (nat_lit 64)))) (r32 n)
def r128 (n : Nat) : Nat := cond (Nat.ble (nat_lit 340282366920938463463374607431768211456) n) (Nat.add (nat_lit 128) (r64 (Nat.shiftRight n (nat_lit 128)))) (r64 n)
def r256 (n : Nat) : Nat := cond (Nat.ble (nat_lit 115792089237316195423570985008687907853269984665640564039457584007913129639936) n) (Nat.add (nat_lit 256) (r128 (Nat.shiftRight n (nat_lit 256)))) (r128 n)
def r512 (n : Nat) : Nat := cond (Nat.ble (nat_lit 13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096) n) (Nat.add (nat_lit 512) (r256 (Nat.shiftRight n (nat_lit 512)))) (r256 n)
def r1024 (n : Nat) : Nat := cond (Nat.ble (nat_lit ) n) (Nat.add (nat_lit 1024) (r512 (Nat.shiftRight n (nat_lit 1024)))) (r512 n)
def r2048 (n : Nat) : Nat := cond (Nat.ble (nat_lit ) n) (Nat.add (nat_lit 2048) (r1024 (Nat.shiftRight n (nat_lit 2048)))) (r1024 n)
def r4096 (n : Nat) : Nat := cond (Nat.ble (nat_lit ) n) (Nat.add (nat_lit 4096) (r2048 (Nat.shiftRight n (nat_lit 4096)))) (r2048 n)
def s1 (n : Nat) : Nat := bif 2 ≤ n then 1 else 0
def s2 (n : Nat) : Nat := bif 2 ^ 2 ≤ n then 2 + s1 (n >>> 2) else s1 n
def s4 (n : Nat) : Nat := bif 2 ^ 4 ≤ n then 4 + s2 (n >>> 4) else s2 n
def s8 (n : Nat) : Nat := bif 2 ^ 8 ≤ n then 8 + s4 (n >>> 8) else s4 n
def s16 (n : Nat) : Nat := bif 2 ^ 16 ≤ n then 16 + s8 (n >>> 16) else s8 n
def s32 (n : Nat) : Nat := bif 2 ^ 32 ≤ n then 32 + s16 (n >>> 32) else s16 n
def s64 (n : Nat) : Nat := bif 2 ^ 64 ≤ n then 64 + s32 (n >>> 64) else s32 n
def s128 (n : Nat) : Nat := bif 2 ^ 128 ≤ n then 128 + s64 (n >>> 128) else s64 n
def s256 (n : Nat) : Nat := bif 2 ^ 256 ≤ n then 256 + s128 (n >>> 256) else s128 n
def s512 (n : Nat) : Nat := bif 2 ^ 512 ≤ n then 512 + s256 (n >>> 512) else s256 n
def s1024 (n : Nat) : Nat := bif 2 ^ 1024 ≤ n then 1024 + s512 (n >>> 1024) else s512 n
def s2048 (n : Nat) : Nat := bif 2 ^ 2048 ≤ n then 2048 + s1024 (n >>> 2048) else s1024 n
def s4096 (n : Nat) : Nat := bif 2 ^ 4096 ≤ n then 4096 + s2048 (n >>> 4096) else s2048 n

#kbench 20 "raw" r4096 50975255206344927097802955061360 = 105
#kbench 20 "bif" s4096 50975255206344927097802955061360 = 105
#kbench 20 "raw64" r64 50975255206344927097802955061360 = 105
#kbench 20 "Nat.add" Nat.add 50975255206344927097802955061360 1 = 50975255206344927097802955061361
#kbench 20 "Nat.add2" Nat.add (Nat.add 50975255206344927097802955061360 1) 1 = 50975255206344927097802955061362
#kbench 20 "cond" cond (Nat.ble 2 50975255206344927097802955061360) 1 0 = 1
