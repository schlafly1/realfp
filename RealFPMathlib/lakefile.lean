import Lake
open Lake DSL

/-! Optional Mathlib layer for Interval64 (realfp).

The core package (`..`) stays Mathlib-free. This package depends on both the
core and Mathlib and restates the core theorems over `ℝ`.

Mathlib must be built for exactly the same Lean version as the core
(`lean-toolchain` here and in `..` must agree); the Mathlib tag below matches
`leanprover/lean4:v4.36.0`. Upgrade both together. -/

package «realfp_mathlib» where
  version := v!"0.1.1"
  description := "realfp: kernel-checked real-number bounds in Lean 4 + Mathlib via interval arithmetic"
  license := "Apache-2.0"
  homepage := "https://github.com/schlafly1/realfp"
  moreLeanArgs := #["-DautoImplicit=false"]
  -- No `precompileModules` here: that would compile Mathlib to native code.
  -- The core package precompiles its own modules, so importing `Interval64`
  -- still loads the C kernels for `#eval` / `native_decide`.
  moreLinkArgs := #["-lm"]
  -- Our files are not `module`s (the core is not), so silence Lake's
  -- "imports Mathlib, which is designed for the module system" warning.
  allowNonModules := true

require interval64 from ".."

require mathlib from git
  "https://github.com/leanprover-community/mathlib4" @ "v4.36.0"

/-- `import RealFPMathlib` gives `Basic`, `Mem`, `Tight`. `RealFPMathlib.Demo`
    (uses `native_decide`) is built and checked but not imported by the root. -/
@[default_target]
lean_lib RealFPMathlib where
  globs := #[.andSubmodules `RealFPMathlib]

/-- **Optional, not a default target.** Slow first-round Float-spec examples (`decide +kernel` on
    the `Float` specification): `taylor_exp_pos`, `gauss_integral_bounds` (PolyQuad) and
    `hilbert_posDef` (6×6 Hilbert, MatrixPD). Build with `lake build RealFPMathlibSlow`;
    axioms with `scripts/check_axioms.sh RealFPMathlib RealFPMathlibSlowAxioms.lean`. -/
lean_lib RealFPMathlibSlow where
  globs := #[.submodules `RealFPMathlibSlow]

/-! ### Optional: `RealFP.Grid` (many-box certificates, `docs/GPU.md`). Not default targets.

`lake build RealFPGrid` builds the native part (`RealFPGridNative`: Mathlib-free, precompiled, with
the C batch checker `c/grid_tape.c`) and the Mathlib layer (`RealFPGrid`: soundness theorems and
the `interval_grid` tactic). No GPU or CUDA is needed: the search tool `grid/` is separate. -/

/-- The C batch checker. No backend flags: it calls realfp's `iv64_dir_*` kernels (from the core
    library), so it uses whatever backend the core was built with. -/
target grid_tape.o pkg : System.FilePath := do
  let oFile := pkg.buildDir / "c" / "grid_tape.o"
  let srcJob ← inputTextFile <| pkg.dir / "c" / "grid_tape.c"
  let weakArgs := #["-I", (← getLeanIncludeDir).toString]
  buildO oFile srcJob weakArgs
    #["-fPIC", "-O2", "-ffp-contract=off", "-frounding-math", "-fno-math-errno"] "cc"

extern_lib librealfpgrid pkg := do
  let o ← fetch <| pkg.target ``grid_tape.o
  buildStaticLib (pkg.staticLibDir / nameToStaticLib "realfpgrid") #[o]

/-- Native part of `RealFP.Grid` (no Mathlib), compiled to native code for `native_decide`. -/
lean_lib RealFPGridNative where
  globs := #[.andSubmodules `RealFPGridNative]
  precompileModules := true

/-- `import RealFPGrid`: soundness theorems and the `interval_grid` tactic (needs Mathlib). -/
lean_lib RealFPGrid where
  globs := #[.andSubmodules `RealFPGrid]

/-- Examples for `RealFP.Grid` (`docs/GPU.md`); certificates in `RealFPGridExamples/certs/`. -/
lean_lib RealFPGridExamples where
  globs := #[.andSubmodules `RealFPGridExamples]

/-- Showcases for `RealFP.Grid` with big certificates (`RealFPGridShowcase/README.md`): the
    proofs are generated by `grid/showcase.sh` (they need the `realfp-grid` tool and minutes to
    hours of CPU time), so this library is built only by that script. -/
lean_lib RealFPGridShowcase where
  globs := #[.andSubmodules `RealFPGridShowcase]
